<Project Sdk="Aspire.AppHost.Sdk/13.4.3">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UserSecretsId>df60b635-1ade-4414-b7e8-a907994527df</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.AppHost" Version="9.3.0" />
    <PackageReference Include="Aspire.Hosting.NodeJs" Version="9.3.0" />
    <PackageReference Include="Aspire.Hosting.Qdrant" Version="9.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AgentFrameworkRag.Api\AgentFrameworkRag.Api.csproj" />
  </ItemGroup>

  <Target Name="RestoreNpm" BeforeTargets="Build" Condition="'$(DesignTimeBuild)' != 'true'">
    <ItemGroup>
      <PackageJsons Include="..\react-frontend\package.json" />
    </ItemGroup>
    <Exec Command="npm install"
          WorkingDirectory="%(PackageJsons.RootDir)%(PackageJsons.Directory)"
          Condition="!Exists('%(PackageJsons.RootDir)%(PackageJsons.Directory)node_modules')" />
  </Target>

</Project>
